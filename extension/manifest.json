{
  "manifest_version": 3,
  "name": "Le Coffre",
  "version": "0.1.0",
  "description": "Read-only access to the passwords of one group in your self-hosted Le Coffre vault.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Le Coffre"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage", "alarms", "offscreen", "clipboardWrite"],
  "optional_host_permissions": ["https://*/*", "http://*/*"]
}
