{
  "name": "le-coffre-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "run-p type-check \"build-only {@}\" -- && bun run scripts/validate-manifest.ts dist",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "test:unit": "vitest",
    "lint": "eslint . --fix",
    "format": "prettier --write src/",
    "validate-manifest": "bun run scripts/validate-manifest.ts dist",
    "package": "./scripts/package.sh"
  },
  "dependencies": {
    "vue": "3.5.44",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@tsconfig/node22": "22.0.6",
    "@types/chrome": "0.3.5",
    "@types/jsdom": "28.0.1",
    "@types/node": "25.9.9",
    "@vitejs/plugin-vue": "6.0.10",
    "@vitest/eslint-plugin": "1.6.27",
    "@vue/eslint-config-prettier": "10.2.0",
    "@vue/eslint-config-typescript": "14.9.0",
    "@vue/test-utils": "2.5.1",
    "@vue/tsconfig": "0.9.1",
    "eslint": "10.13.0",
    "eslint-plugin-vue": "10.11.1",
    "jiti": "2.7.0",
    "jsdom": "29.1.1",
    "npm-run-all2": "8.0.4",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "4.1.12",
    "vue-tsc": "3.3.13"
  },
  "overrides": {
    "@vue/server-renderer": "3.5.43",
    "brace-expansion": "5.0.12",
    "minimatch": "10.2.6",
    "shell-quote": "1.12.0",
    "source-map-js": "1.2.2",
    "undici": "7.30.0"
  }
}
